{
  "name": "@pavelpernicka/fakturoid-api",
  "version": "0.1.4",
  "description": "TypeScript client for Fakturoid API v3, with Node.js ESM support and safe write semantics.",
  "packageManager": "bun@1.3.5",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/pavelpernicka/fakturoid-api.git"
  },
  "bugs": {
    "url": "https://github.com/pavelpernicka/fakturoid-api/issues"
  },
  "homepage": "https://github.com/pavelpernicka/fakturoid-api#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --write .",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src",
    "test:node": "npm run build && node --test tests/node/*.test.mjs",
    "test:integration": "bun test tests/integration",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "fakturoid",
    "sdk",
    "typescript",
    "oauth2"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "bun-types": "^1.3.10",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
